{
  "TokenValidation": {
    "Audiences": [
      "<BOT_APP_ID>"
    ],
    "TenantId": "<TENANT_ID>",
    "Enabled": false
  },
  "AgentApplicationOptions": {
    "StartTypingTimer": true,
    "RemoveRecipientMention": false,
    "NormalizeMentions": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Agents": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.SemanticKernel*": "Warning"
    }
  },
  "Connections": {
    "BotServiceConnection": {
      "Settings": {
        "AuthType": "ClientSecret",
        "AuthorityEndpoint": "https://login.microsoftonline.com/<TENANT_ID>",
        "ClientId": "<BOT_APP_ID>",
        "ClientSecret": "<BOT_APP_SECRET>",
        "Scopes": [
          "https://api.botframework.com/.default"
        ]
      }
    },
    "ServiceConnection": {
      "Settings": {
        "AuthType": "ClientSecret",
        "AuthorityEndpoint": "https://login.microsoftonline.com/<TENANT_ID>",
        "ClientSecret": "<BLUEPRINT_APP_SECRET>",
        "ClientId": "<BLUEPRINT_APP_ID>",
        "AgentId": "<BLUEPRINT_APP_ID>",
        "Scopes": [
          "<BLUEPRINT_APP_ID>/.default"
        ]
      }
    }
  },
  "ConnectionsMap": [
    {
      "ServiceUrl": "*",
      "Connection": "ServiceConnection"
    }
  ],
  "AIServices": {
    "AzureOpenAI": {
      "DeploymentName": "gpt-5.4-mini",
      "Endpoint": "<OPENAI_ENDPOINT>"
    }
  },
  "OpenWeatherApiKey": "<OPENWEATHER_API_KEY>",
  "AgentApplication": {
    "StartTypingTimer": false,
    "RemoveRecipientMention": false,
    "NormalizeMentions": false,
    "UserAuthorization": {
      "AutoSignin": false,
      "Handlers": {
        "agentic": {
          "Type": "AgenticUserAuthorization",
          "Settings": {
            "AlternateBlueprintConnectionName": "ServiceConnection",
            "Scopes": [
              "https://graph.microsoft.com/.default"
            ]
          }
        }
      }
    }
  },
  "EnableAgent365Exporter": false,
  "Agent365Observability": {
    "AgentId": "<AGENT_IDENTITY_OBJECT_ID>",
    "AgentName": "bot-agent365-weather Identity",
    "AgentDescription": "bot-agent365-weather",
    "TenantId": "<TENANT_ID>",
    "AgentBlueprintId": "<BLUEPRINT_APP_ID>",
    "ClientId": "<BLUEPRINT_APP_ID>",
    "ClientSecret": "<BLUEPRINT_APP_SECRET>"
  }
}