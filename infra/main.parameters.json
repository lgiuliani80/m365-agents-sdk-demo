{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "botAuthenticationMode": {
      "value": "${BOT_AUTHENTICATION_MODE=managedIdentity}"
    },
    "botPublicNetworkAccessEnabled": {
      "value": "${BOT_PUBLIC_NETWORK_ACCESS_ENABLED=true}"
    },
    "azureOpenAIResourceGroupName": {
      "value": "${AZURE_OPENAI_RESOURCE_GROUP}"
    },
    "azureOpenAIAccountName": {
      "value": "${AZURE_OPENAI_ACCOUNT_NAME}"
    },
    "azureOpenAIEndpoint": {
      "value": "${AZURE_OPENAI_ENDPOINT}"
    },
    "azureOpenAIDeploymentName": {
      "value": "${AZURE_OPENAI_DEPLOYMENT_NAME}"
    },
    "openWeatherApiKey": {
      "value": "${OPENWEATHER_API_KEY=}"
    },
    "botCertificatePem": {
      "value": "${BOT_CERTIFICATE_PEM=}"
    },
    "botCertificatePublicBase64": {
      "value": "${BOT_CERTIFICATE_PUBLIC_BASE64=}"
    },
    "botCertificateThumbprint": {
      "value": "${BOT_CERTIFICATE_THUMBPRINT=}"
    }
  }
}
